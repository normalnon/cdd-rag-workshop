# ค่าตั้งของเรา — notebook, script และ docker compose อ่านไฟล์ .env ไฟล์เดียวกัน
#
# วิธีใช้
#   cp .env.example .env
#   nano .env                แก้ทุกจุดที่เขียนว่า XX เป็นเลขประจำตัว 2 หลัก และตั้งรหัส QDRANT_API_KEY
#
# เลขประจำตัว = เลขท้ายชื่อ user (cdd07 → 07) ทุกคนใช้ server เครื่องเดียวกัน
# เลขจึงทำให้ port และ Qdrant ของเราไม่ชนกับคนอื่น
#   ตัวอย่างเลข 07 → STUDENT=07 · QDRANT_PORT=16307 · QDRANT_URL=http://127.0.0.1:16307 · GROUP=g07

STUDENT=XX

# LLM ตัวกลางของห้อง (vllm-server) — ไม่ต้องแก้
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=qwen3-27b
LLM_API_KEY=EMPTY
# off = ปิดโหมดคิดก่อนตอบของ Qwen3 → ตอบเร็วขึ้น
LLM_THINKING=off

# Embedding bge-m3 ตัวกลางของห้อง — ไม่ต้องแก้
EMBED_BASE_URL=http://127.0.0.1:8001/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=EMPTY
EMBED_DIM=1024

# Qdrant ของเราเอง (docker compose up -d) — port = 16300 + เลข
QDRANT_PORT=163XX
QDRANT_URL=http://127.0.0.1:163XX
# ตั้งรหัสอะไรก็ได้ (ตัวอักษร/ตัวเลข) กันคนอื่นบน server เข้ามาแก้ข้อมูลของเรา
QDRANT_API_KEY=

# collection ของเรา = cdd_docs_gXX
GROUP=gXX

DATA_DIR=data/raw
