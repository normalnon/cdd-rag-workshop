# ค่าตั้งของเรา — notebook, script และ docker compose อ่านไฟล์ .env ไฟล์เดียวกัน
#
# วิธีใช้
#   cp .env.example .env     (Windows: copy .env.example .env)
#   เปิด .env แก้ทุกจุดที่เขียนว่า XX เป็นเลขประจำตัว 2 หลัก และใส่ QDRANT_API_KEY
#
# ไฟล์ .env อยู่แค่ในเครื่องเรา ไม่ถูก upload ขึ้น git
#
# เลขประจำตัว = เลขท้ายชื่อ user (cdd07 → 07) ทำให้ port และ Qdrant ของเราไม่ชนกับคนอื่น
#   ตัวอย่างเลข 07 → STUDENT=07 · QDRANT_PORT=16307 · QDRANT_URL=http://127.0.0.1:16307 · GROUP=g07
#
# รันบนเครื่องตัวเอง: ค่า 127.0.0.1 ด้านล่างใช้ได้เลย เมื่อเปิด SSH tunnel ไว้ (ดู docs/LOCAL_SETUP.md)
#   ssh -N -L 8000:127.0.0.1:8000 -L 8001:127.0.0.1:8001 -L 163XX:127.0.0.1:163XX cddXX@<IP server>

STUDENT=XX

# LLM ตัวกลางของห้อง (vllm-server) — ไม่ต้องแก้
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=qwen3-27b
LLM_API_KEY=EMPTY
# off = ปิดโหมดคิดก่อนตอบของ Qwen3 → ตอบเร็วขึ้น
LLM_THINKING=off

# Embedding bge-m3 ตัวกลางของห้อง — ไม่ต้องแก้
EMBED_BASE_URL=http://127.0.0.1:8001/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=EMPTY
EMBED_DIM=1024

# Qdrant ของเราเองบน server (docker compose up -d) — port = 16300 + เลข
QDRANT_PORT=163XX
QDRANT_URL=http://127.0.0.1:163XX
# ต้องตรงกับรหัสที่ใช้ตอนเปิด Qdrant บน server ถ้าไม่ตรงจะขึ้น 401 Unauthorized
# ดูรหัสเดิมบน server: grep QDRANT_API_KEY ~/cdd-rag/.env
QDRANT_API_KEY=

# collection ของเรา = cdd_docs_gXX
GROUP=gXX

DATA_DIR=data/raw
